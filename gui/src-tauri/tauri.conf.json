{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harnex Memory",
  "version": "0.1.0",
  "identifier": "com.harnex.memory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harnex Memory",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": []
  }
}
